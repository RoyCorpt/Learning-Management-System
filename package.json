{
  "name": "lms-ptik",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @lms/shared && npm run build -w @lms/web && npm run dev -w @lms/api",
    "start": "node apps/api/dist/server.js",
    "build": "npm run build -w @lms/shared && npm run build -w @lms/api && npm run build -w @lms/web",
    "postinstall": "npm run db:generate",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @lms/api",
    "db:migrate": "npm run db:migrate -w @lms/api",
    "db:deploy": "npm run db:deploy -w @lms/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
