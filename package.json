{
  "name": "lms-ptik",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lms/api",
    "start": "node apps/api/dist/apps/api/src/server.js",
    "build": "npm run build -w @lms/shared && npm run build -w @lms/api && npm run build -w @lms/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "pg": "^8.23.1"
  }
}
