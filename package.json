{
  "name": "lms-ptik",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @lms/api",
    "start": "node apps/api/dist/apps/api/src/server.js",
    "build": "npm run build -w @lms/shared && npm run build -w @lms/api && npm run build -w @lms/web",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
