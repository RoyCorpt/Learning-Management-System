NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
# Configure only the actual trusted proxy address(es) when deploying behind a reverse proxy.
# TRUST_PROXY=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_ptik?schema=public
COOKIE_SECURE=false
STUDENT_EMAIL_DOMAINS=unimed.ac.id,mhs.unimed.ac.id
SESSION_TTL_HOURS=12
# Set these only in a trusted shell for the one-time `npm run db:bootstrap-admin -w @lms/api` operation.
# Do not commit real credentials or add them to logs.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# BOOTSTRAP_ADMIN_NAME=Initial Administrator
# BOOTSTRAP_ADMIN_PASSWORD=use-a-random-password-of-at-least-16-characters
