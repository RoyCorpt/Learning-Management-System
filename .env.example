API_PORT=3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
NODE_ENV=development
SESSION_TTL_HOURS=12
STUDENT_EMAIL_DOMAINS=unimed.ac.id,mhs.unimed.ac.id
# Valid values: loopback | linklocal | uniquelocal | false | 0..5 | IP/CIDR list (never 'true')
TRUST_PROXY=loopback
VITE_API_URL=
WEB_ORIGIN=http://localhost:3000
# Optional extra comma-separated exact CORS origins if needed
# CORS_ALLOWED_ORIGINS=

# PostgreSQL connection (defaults match docker-compose.yml local container)
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=lms_ptik
SQL_USER=postgres
SQL_PASSWORD=postgres
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres

# Or set DATABASE_URL for external PostgreSQL / Cloud SQL (used when SQL_* is unset/commented out)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_ptik
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# Password reset, PostgreSQL rate limiting & SMTP email delivery (Lupa Kata Sandi)
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_WINDOW_MINUTES=15
PASSWORD_RESET_IP_LIMIT=20
PASSWORD_RESET_ACCOUNT_LIMIT=5
# Optional HMAC secret for keyed rate-limit account identifiers in production
# RATE_LIMIT_SECRET=replace-with-long-random-secret
# Development-only flag to log reset-link previews when SMTP_HOST is unset (forbidden in production)
PASSWORD_RESET_DEV_PREVIEW=true
# Production requires valid SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, and SMTP_FROM
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SINTAKS <no-reply@sintaks.local>