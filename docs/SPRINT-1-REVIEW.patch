+        {user && message && <div className="feedback" role="status">{message}</div>}
+      </section>
+    </section>
+    <footer className="footer"><span>LMS PTIK · Sistem pembelajaran kampus</span><span>© 2026</span></footer>
   </main>;
 }
+
+function ChangePassword({ email, onDone }: { email: string; onDone: (user: User) => void }) {
+  const [message, setMessage] = useState(''); const [busy, setBusy] = useState(false);
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault(); setBusy(true); setMessage(''); const formElement = event.currentTarget; const form = new FormData(formElement);
+    try { const newPassword = String(form.get('newPassword')); await request('/auth/change-password', { currentPassword: form.get('currentPassword'), newPassword }); formElement.reset(); const result = await request('/auth/login', { email, password: newPassword }); onDone(result.user); setMessage('Kata sandi diperbarui. Silakan lanjutkan.'); }
+    catch (error) { setMessage(error instanceof Error ? error.message : 'Gagal mengganti kata sandi.'); }
+    finally { setBusy(false); }
+  }
+  return <form className="change-form" onSubmit={submit}><h3>Perbarui kata sandi sementara</h3><label>Kata sandi sementara<input name="currentPassword" type="password" required /></label><label>Kata sandi baru<input name="newPassword" type="password" minLength={12} maxLength={200} required /></label>{message && <div className="feedback" role="status">{message}</div>}<button className="button primary" disabled={busy}>Simpan kata sandi</button></form>;
+}
+
+function AccountManagement() {
+  const [users, setUsers] = useState<Array<User & { status: string }>>([]); const [message, setMessage] = useState('');
+  async function load() { try { const result = await request('/auth/admin/users', undefined, 'GET'); setUsers(result.users); } catch (error) { setMessage(error instanceof Error ? error.message : 'Gagal memuat akun.'); } }
+  useEffect(() => { void load(); }, []);
+  async function create(event: FormEvent<HTMLFormElement>) { event.preventDefault(); const formElement = event.currentTarget; const form = new FormData(formElement); try { const result = await request('/auth/admin/instructors', Object.fromEntries(form.entries())); formElement.reset(); setMessage(`Akun dibuat. Kata sandi awal (tampilkan sekali): ${result.temporaryPassword}. Berikan melalui saluran aman.`); await load(); } catch (error) { setMessage(error instanceof Error ? error.message : 'Gagal membuat akun.'); } }
+  async function importRoster(event: FormEvent<HTMLFormElement>) { event.preventDefault(); const formElement = event.currentTarget; const file = new FormData(formElement).get('roster'); if (!(file instanceof File) || file.size === 0) { setMessage('Pilih file roster CSV terlebih dahulu.'); return; } try { const result = await request('/auth/admin/roster/import', { csv: await file.text() }); formElement.reset(); setMessage(`Impor roster selesai: ${result.summary.rows} baris, ${result.summary.created} baru, ${result.summary.updated} diperbarui.`); } catch (error) { setMessage(error instanceof Error ? error.message : 'Impor roster gagal.'); } }
+  async function update(id: string, path: 'status'|'role', value: string) { try { const result = await request(`/auth/admin/users/${id}/${path}`, { [path]: value }, 'PATCH'); setMessage(result.temporaryPassword ? `Perubahan tersimpan. Kata sandi awal (tampilkan sekali): ${result.temporaryPassword}. Berikan melalui saluran aman.` : 'Perubahan akun tersimpan.'); await load(); } catch (error) { setMessage(error instanceof Error ? error.message : 'Gagal memperbarui akun.'); } }
+  return <section className="admin-panel"><h3>Administrasi akun</h3><form className="change-form" onSubmit={create}><h4>Buat akun Dosen</h4><label>Nama lengkap<input name="fullName" required maxLength={150}/></label><label>Email<input name="email" type="email" required maxLength={255}/></label><button className="button primary">Buat akun</button></form><form className="change-form" onSubmit={importRoster}><h4>Impor roster Mahasiswa</h4><p className="card-intro">CSV roster kampus dengan kolom NIM, nama, email, dan status kelayakan.</p><label>File roster<input name="roster" type="file" accept=".csv,text/csv" required/></label><button className="button secondary">Impor roster</button></form><h4>Akun terbaru</h4><div className="account-list">{users.map((u)=><div className="account-row" key={u.id}><div><strong>{u.fullName}</strong><span>{u.email}</span></div><select aria-label={`Peran ${u.email}`} value={u.role} onChange={(e)=>void update(u.id,'role',e.target.value)}><option value="ADMIN">Admin</option><option value="DOSEN">Dosen</option><option value="MAHASISWA">Mahasiswa</option></select><select aria-label={`Status ${u.email}`} value={u.status} onChange={(e)=>void update(u.id,'status',e.target.value)}><option value="ACTIVE">Aktif</option><option value="INACTIVE">Nonaktif</option><option value="PENDING">Menunggu</option></select></div>)}</div>{message && <div className="feedback" role="status">{message}</div>}</section>;
+}
